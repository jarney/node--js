<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	    xmlns:node="http://jarney.github.io/nodejs/schema"
	    xmlns:codegen="http://jarney.github.io/nodejs/comment"
	    targetNamespace="http://jarney.github.io/nodejs/schema"
	    elementFormDefault="qualified"
	    attributeFormDefault="unqualified">

  <codegen:include name="NodeList"/>
  <codegen:include name="EdgeList"/>
  <codegen:include name="Metadata"/>
  
  <xsd:complexType name="Graph">
    <xsd:all>
      <xsd:element name="nodes" type="node:NodeList"/>
      <xsd:element name="edges" type="node:EdgeList"/>
      <xsd:element name="metadata" type="node:Metadata" minOccurs="0"/>
    </xsd:all>
    <xsd:attribute name="id"/>
  </xsd:complexType>
</xsd:schema>
