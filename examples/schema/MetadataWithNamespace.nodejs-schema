	    xmlns:node="http://jarney.github.io/nodejs/schema"
	    xmlns:codegen="http://jarney.github.io/nodejs/comment"
	    targetNamespace="http://jarney.github.io/nodejs/schema"
	    elementFormDefault="qualified"
	    attributeFormDefault="unqualified">
  <xsd:complexType name="MetadataWithNamespace">
    <xsd:sequence minOccurs="0" maxOccurs="unbounded">
      <xsd:element name="value" codegen:name="values" type="node:NameValuePair"/>
