<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	    xmlns:node="http://jarney.github.io/nodejs/schema"
	    xmlns:codegen="http://jarney.github.io/nodejs/comment"
	   targetNamespace="http://jarney.github.io/nodejs/schema"
	   elementFormDefault="qualified"
	   attributeFormDefault="unqualified">
  <xsd:complexType name="Port">
    <xsd:attribute name="id"/>
    <xsd:attribute name="description"/>
    <xsd:attribute name="data-type" codegen:name="dataType"/>
    <xsd:attribute name="connection-policy" codegen:name="connectionPolicy" type="node:PortConnectionPolicy"/>
  </xsd:complexType>
</xsd:schema>