<?xml version="1.0"?>
<node-module xmlns="http://jarney.github.io/nodejs-schema">
  <!--
    - This is the interface to OpenSCAD.
    - This consists of a bunch of nodes that are designed
    - mimic the OpenSCAD declaration language.  With a suitable
    - node processor, it is possible to convert programs
    - in OpenSCAD to NodeJS language and vice-versa.
    -->
  <package id="org.ensor.nodejs.openscad"/>
  <data-types>
    <!--
      - These are (for now) purely documentary.
      - There is no 'hard' validation of data types,
      - their origin, or function at this level.  They
      - exist purely as identifiers that tie ports together.
      -->
    <data-type id="variable" name="OpenSCAD Variable"/>
    <data-type id="geometry" name="OpenSCAD Geometry"/>
    
    <data-type id="assignment" name="OpenSCAD Variable Assignment"/>
    <data-type id="function-definition" name="OpenSCAD Function Definition"/>
    <data-type id="module-definition" name="OpenSCAD Module Definition"/>
  </data-types>
  <!--
    - This is the set of nodes provided by the OpenSCAD
    - implementation.  Each of these node processors
    - are added by a native implementation library.
    -->
  <node-types>
    <!-- Output to be rendered -->
    <node-type id="output" visibility="public" type="native">
      <inputs>
	<port id="assignments" description="Variable Assignments" data-type="assignment" connection-policy="multi"/>
	<port id="function-definitions" description="Function Definitions" data-type="function-definition" connection-policy="multi"/>
	<port id="module-definitions" description="Module Definitions" data-type="module-definition" connection-policy="multi"/>
	<port id="module-instantiations" description="Output to render" data-type="geometry" connection-policy="multi"/>
      </inputs>
      <outputs/>
    </node-type>
    <!-- 2D Primitives -->
    <node-type id="circle" visibility="public" type="native">
      <inputs>
        <port id="r" description="r" data-type="variable" connection-policy="one"/>
        <port id="d" description="d" data-type="variable" connection-policy="one"/>
      </inputs>
      <outputs>
        <port id="Geometry" description="Geometry" data-type="geometry" connection-policy="multi"/>
      </outputs>
    </node-type>
    <node-type id="square" visibility="public" type="native">
