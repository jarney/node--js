<?xml version="1.0"?>
<node-module xmlns="http://jarney.github.io/nodejs/schema">
  <!--
      - This is the interface to OpenSCAD.
      - This consists of a bunch of nodes that are designed
      - mimic the OpenSCAD declaration language.  With a suitable
      - node processor, it is possible to convert programs
      - in OpenSCAD to NodeJS language and vice-versa.
  -->
  <package id="org.ensor.nodejs.openscad"/>
  <data-types>
    <!--
	These are (for now) purely documentary.
	There is no 'hard' validation of data types,
	their origin, or function at this level.  They
	exist purely as identifiers that tie ports together.
    -->
    <data-type id="variable" name="OpenSCAD Variable"/>
    <data-type id="geometry" name="OpenSCAD Geometry"/>
  </data-types>
  <node-types>
    <node-type id="sphere" visibility="public" type="native" allow-port-override="false">
      <inputs>
	<port id="r" description="r" data-type="variable"/>
	<port id="d" description="d" data-type="variable"/>
      </inputs>
      <outputs>
	<port id="Geometry" description="Geometry" data-type="geometry"/>
      </outputs>
    </node-type>
    <node-type id="variable" visibility="public" type="native">
      <inputs></inputs>
      <outputs>
	<port id="value" description="Nothing" data-type="variable"/>
      </outputs>
    </node-type>
    <node-type id="const_true" visibility="public" type="native">
      <inputs>
      </inputs>
      <outputs>
	<port id="value" description="Value" data-type="variable"/>
      </outputs>
    </node-type>
    <node-type id="const_false" visibility="public" type="native">
      <inputs>
      </inputs>
      <outputs>
	<port id="value" description="Value" data-type="variable"/>
      </outputs>
    </node-type>
    <node-type id="const_int" visibility="public" type="native">
      <inputs>
      </inputs>
      <outputs>
	<port id="value" description="Value" data-type="variable"/>
      </outputs>
    </node-type>
    <node-type id="const_float" visibility="public" type="native">
      <inputs>
      </inputs>
      <outputs>
	<port id="value" description="Value" data-type="variable"/>
      </outputs>
    </node-type>
    <node-type id="const_string" visibility="public" type="native">
      <inputs>
      </inputs>
      <outputs>
	<port id="value" description="Value" data-type="variable"/>
      </outputs>
    </node-type>
    <node-type id="const_undef" visibility="public" type="native" allow-port-override="true">
      <inputs>
      </inputs>
      <outputs>
	<port id="value" description="Value" data-type="variable"/>
      </outputs>
    </node-type>
    <!-- more nodes will follow -->
  </node-types>
  <graphs>
    <graph id="main">
      <scope>
	<import id="openscad-builtins"/> <!-- import an exported registry -->
        <define-type id="foo"/> <!-- define a specific type in this registry (but probably not export it) -->
      </scope>
      <nodes>
	<node id="x" type="variable">
	  <value key="variable-name">x</value>
	</node>
	<node id="sphere" type="sphere">
	</node>
	<node id="const_undef" type="const_undef">
	  <inputs>
	    <port id="value" description="Value" data-type="variable"/>
	  </inputs>
	  <outputs>
	    <port id="value" description="Value" data-type="variable"/>
	  </outputs>
	</node>
      </nodes>
      <edges>
	<edge from-node="x" from-port="value" to-node="sphere" to-port="r"/>
	<edge from-node="x" from-port="value" to-node="sphere" to-port="r"/>
      </edges>
    </graph>
  </graphs>
</node-module>
